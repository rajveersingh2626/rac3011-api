model Event {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  startsAt        DateTime       @map("starts_at")
  endsAt          DateTime?      @map("ends_at")
  location        String?
  description     String?
  coverUrl        String?        @map("cover_url")
  isDistrictEvent Boolean        @default(true) @map("is_district_event")
  clubId          String?        @map("club_id")
  club            Club?          @relation(fields: [clubId], references: [id])
  projectKey      ProjectKey?    @map("project_key")
  rsvpOpen        Boolean        @default(true) @map("rsvp_open")
  capacity        Int?
  photos          String[]       @default([])
  createdById     String         @map("created_by_id")
  rsvps           EventRsvp[]
  checkins        EventCheckin[]
  feedback        Feedback[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([startsAt])
  @@index([clubId])
  @@index([projectKey])
  @@map("events")
}

enum RsvpStatus {
  going
  maybe
  not_going
}

model EventRsvp {
  eventId   String        @map("event_id")
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String        @map("member_id")
  member    MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    RsvpStatus
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@id([eventId, memberId])
  @@index([memberId])
  @@map("event_rsvps")
}

enum CheckinMethod {
  qr
  manual
  walk_in
}

model EventCheckin {
  id            String         @id @default(cuid())
  eventId       String         @map("event_id")
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId      String?        @map("member_id")
  member        MemberProfile? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  walkInName    String?        @map("walk_in_name")
  clubId        String         @map("club_id")
  club          Club           @relation(fields: [clubId], references: [id])
  method        CheckinMethod
  checkedInAt   DateTime       @default(now()) @map("checked_in_at")
  checkedInById String         @map("checked_in_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([eventId, memberId])
  @@index([eventId, clubId])
  @@index([memberId])
  @@index([clubId])
  @@map("event_checkins")
}

enum BookingPurpose {
  installation
  club_event
  meeting
}

enum BookingStatus {
  requested
  held
  confirmed
  declined
  cancelled
}

model DrrBooking {
  id             String         @id @default(cuid())
  reference      String         @unique
  purpose        BookingPurpose
  clubId         String?        @map("club_id")
  club           Club?          @relation(fields: [clubId], references: [id])
  requesterName  String         @map("requester_name")
  requesterEmail String         @map("requester_email")
  requesterPhone String         @map("requester_phone")
  startsAt       DateTime       @map("starts_at")
  endsAt         DateTime       @map("ends_at")
  notes          String?
  status         BookingStatus  @default(requested)
  googleEventId  String?        @map("google_event_id")
  decisionReason String?        @map("decision_reason")
  decidedById    String?        @map("decided_by_id")
  decidedAt      DateTime?      @map("decided_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([startsAt])
  @@index([status])
  @@index([clubId])
  @@map("drr_bookings")
}

model DrrBlock {
  id          String   @id @default(cuid())
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  reason      String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([startsAt])
  @@map("drr_blocks")
}

enum FeedbackStatus {
  open
  reviewed
  closed
}

model Feedback {
  id            String         @id @default(cuid())
  submittedById String?        @map("submitted_by_id")
  clubId        String?        @map("club_id")
  club          Club?          @relation(fields: [clubId], references: [id])
  category      String
  message       String
  eventId       String?        @map("event_id")
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  status        FeedbackStatus @default(open)
  reply         String?
  reviewedById  String?        @map("reviewed_by_id")
  reviewedAt    DateTime?      @map("reviewed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([clubId])
  @@index([eventId])
  @@map("feedback")
}
